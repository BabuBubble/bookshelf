<!DOCTYPE html>
<html>
<head>
  <title>login page</title>
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    div .login-menu {
      background-color: var(--main-text-color, #f2f2f2);
      border: 2px solid var(--main-color, #2f2f2f);
      width: 60dvw;
      height: 43dvh;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      position: absolute;
    }
    div .login-menu .input-area {
      font-size: large;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 50dvw;
      top: 10dvh;
      left: 50%;
      transform: translateX(-50%);
      position: absolute;
      border-bottom: 2px solid var(--main-color, #2f2f2f);
    }
    div .login-menu button {
      padding: 0.5rem 1rem;
      background-color: var(--main-color, #2f2f2f);
      color: var(--main-text-color, #f2f2f2);
      text-decoration: none;
      border: none;
      border-radius: 5px;
      font-size: 1rem;
      cursor: pointer;
      transition: background-color 0.3s;
    }
    div .login-menu button:hover {
      background-color: var(--sub-color);
    }
    .signup-form {
      display: flex;
      flex-direction: column;
      width: 50dvw;
      top: 34dvh;
      left: 50%;
      transform: translateX(-50%);
      position: absolute;
    }
    .signup-button {
      display: inline-block;
      padding: 0.6rem 1rem;
      background-color: var(--main-color, #2f2f2f);
      color: var(--main-text-color, #f2f2f2);
      text-decoration: none;
      border: none;
      border-radius: 5px;
      font-size: 1rem;
      text-align: center;
      cursor: pointer;
      transition: background-color 0.3s;
    }
    .signup-button:hover {
      background-color: var(--sub-color);
    }
  </style>
</head>
<body>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('login-form').addEventListener('submit', async function (e) {
        e.preventDefault();
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const response = await fetch('/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }, 
          body: JSON.stringify({email, password})
        });
        const result = await response.json();
        if ( response.ok ) {
          document.getElementById('message').textContent = 'Login Successfull!';
          window.location.href = '/mypage'; // ページ遷移
        } else {
          alert(result.error || 'Login Failed.');
          // document.getElementById('message').textContent = result.error || 'Login Failed.'
        }
      });
    });
  </script>
  <div class = "container">
    <header class = "page-header">
      <h1>Login</h1>
      <a class = "a_button" href = "/">top</a>
    </header>
    <main>
      <div class = "main">
        <div class = "login-menu container">
          <header class = "header"><h1>FORM</h1></header>
          <form id = "login-form" class = "input-area">
            <label for = "email">Email</label>
            <input type = "email" id = "email" placeholder = "your@email.com">
            <label for = "password">Password</label>
            <input type = "password" id = "password" placeholder = "Password">
            <button type = "submit">Login</button>
            <p id = "message"></p>
          </form>
          <section class = "signup-form">
            <a class="signup-button" href = "/register">Sign Up</a>
          </section>
        </div>
      </div>
    </main>
    <footer class = "footer">
      <p>&copy;Babu 2025</p>
    </footer>
  </div>
</body>
</html>
