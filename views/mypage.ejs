<!DOCTYPE html>
<html>
<head>
  <title>MyPage</title>
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/book_style.css">
</head>
<body>
  <div class = "container">
    <header class = "header">
      <div class = "hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <nav class = "menu">
        <ul class = "menu_contents">
          <li><a href="/">Top</a></li>
          <li><a href="/mypage">Mypage</a></li>
          <li><a href="#">Inquiry</a></li>
        </ul>
      </nav>
      <h1><%= title %></h1>
      <a class = "a_button" href = "/">top</a>
    </header>
    <main>
      <div class = "main">
        <div class = "book-shelf">
          <% for (let i = 0; i < 10; i++) { %>
            <div class="book">
              <header class = "header"><a href = "#">title</a></header>
              <div class = "main"></div>
            </div>
          <% } %>
        </div>
      </div>
    </main>
    <footer class = "footer">
      <p>&copy;Babu 2025</p>
    </footer>
  </div>
  <script src = "js/flame.js"></script>
</body>
</html>
